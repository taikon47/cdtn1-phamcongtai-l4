&lt;br&gt;✓ Tay nghề phù hợp&lt;br&gt;✓ Đúng địa bàn&lt;br&gt;✓ Workload chấp nhận&lt;br&gt;✓ Không trùng lịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="510" width="135" height="135" as="geometry"/></mxCell><mxCell id="s2btn" value="XÁC NHẬN PHÂN CÔNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="665" width="200" height="50" as="geometry"/></mxCell><mxCell id="s2note" value="UC2 + UC3 + UC4 + UC6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="730" width="380" height="35" as="geometry"/></mxCell><mxCell id="s3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="905" y="135" width="400" height="650" as="geometry"/></mxCell><mxCell id="s3h" value="MÀN HÌNH 3 – TẠO / XÁC NHẬN LỊCH HẸN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="905" y="135" width="400" height="42" as="geometry"/></mxCell><mxCell id="s3info" value="Phiếu: PB001&lt;br&gt;Kỹ thuật viên: Nguyễn A&lt;br&gt;Trạng thái phân công: Đã phân công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="190" width="370" height="75" as="geometry"/></mxCell><mxCell id="s3form" value="THÔNG TIN LỊCH HẸN&lt;br&gt;&lt;br&gt;Loại lịch: [ Giao máy / Nhận máy ▼ ]&lt;br&gt;&lt;br&gt;Ngày: [ dd/mm/yyyy ]&lt;br&gt;&lt;br&gt;Bắt đầu: [ hh:mm ] &amp;nbsp;&amp;nbsp; Kết thúc: [ hh:mm ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" v