xGeometry x="40" y="235" width="360" height="48" as="geometry"/></mxCell><mxCell id="s1table" value="DANH SÁCH PHIẾU&lt;br&gt;&lt;br&gt;&lt;b&gt;Mã&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;b&gt;Thiết bị&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;b&gt;Lỗi/Yêu cầu&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;b&gt;Địa bàn&lt;/b&gt;&lt;br&gt;PB001 &amp;nbsp; Laptop A &amp;nbsp; Không nguồn &amp;nbsp; Q.1&lt;br&gt;PB002 &amp;nbsp; Máy B &amp;nbsp;&amp;nbsp;&amp;nbsp; Màn hình &amp;nbsp;&amp;nbsp;&amp;nbsp; Q.3&lt;br&gt;PB003 &amp;nbsp; Thiết bị C &amp;nbsp; Pin &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Q.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="205" as="geometry"/></mxCell><mxCell id="s1detail" value="CHI TIẾT PHIẾU ĐANG CHỌN&lt;br&gt;&lt;br&gt;Mã phiếu: PB001&lt;br&gt;Thiết bị: Laptop A&lt;br&gt;Yêu cầu tay nghề: Điện/nguồn&lt;br&gt;Địa bàn: Q.1&lt;br&gt;Trạng thái: Chờ phân công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="220" height="150" as="geometry"/></mxCell><mxCell id="s1btn" value="CHỌN KỸ THUẬT VIÊN →" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="620" width="125" height="55" as="geometry"/></mxCell><mxCell id="s1note" value="UC1: xem phiếu cần phân công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="360" height="45" as="geometry"/></mxCell><mxCell id="s2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="455" y="135" width="410" height="650" as="geometry"/