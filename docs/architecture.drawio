<mxfile host="app.diagrams.net" modified="2026-10-10T04:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
<diagram id="architecture-l4" name="Architecture L4">
<mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1080" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="KIẾN TRÚC HỆ THỐNG L4 – PHÂN CÔNG KỸ THUẬT VIÊN &amp; LỊCH HẸN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1240" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Java 21 • Spring Boot • REST API • PostgreSQL • Kiến trúc phân lớp (Layered Architecture)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1240" height="32" as="geometry"/></mxCell><mxCell id="user" value="NHÂN VIÊN ĐIỀU PHỐI&lt;br&gt;&lt;br&gt;• Xem phiếu bảo hành&lt;br&gt;• Chọn kỹ thuật viên&lt;br&gt;• Tạo / xác nhận lịch hẹn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="155" width="185" height="145" as="geometry"/></mxCell><mxCell id="frontend" value="PRESENTATION / UI&lt;br&gt;&lt;br&gt;Web UI / Wireframe&lt;br&gt;&lt;br&gt;Gửi yêu cầu HTTP&lt;br&gt;Hiển thị dữ liệu &amp; lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="285" y="155" width="200" height="145" as="geometry"/></mxCell><mxCell id="controller" value="CONTROLLER LAYER&lt;br&gt;&lt;br&gt;Spring Boot REST Controller&lt;br&gt;&lt;br&gt;• WarrantyTicketController&lt;br&gt;• TechnicianController&lt;br&gt;• AppointmentController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="135" width="235" height="185" as="geometry"/></mxCell><mxCell id="service" value="SERVICE / BUSINESS LAYER&lt;br&gt;&lt;br&gt;• AssignmentService&lt;br&gt;• AppointmentService&lt;br&gt;&lt;br&gt;Kiểm tra tay nghề, địa bàn,&lt;br&gt;khối lượng công việc,&lt;br&gt;khả dụng &amp; trùng lịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="125" width="245" height="205" as="geometry"/></mxCell><mxCell id="repository" value="DATA ACCESS LAYER&lt;br&gt;&lt;br&gt;Spring Data JPA / Repository&lt;br&gt;&lt;br&gt;• WarrantyTicketRepository&lt;br&gt;• TechnicianRepository&lt;br&gt;• AppointmentRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="385" width="245" height="180" as="geometry"/></mxCell><mxCell id="database" value="POSTGRESQL&lt;br&gt;&lt;br&gt;Dữ liệu L4&lt;br&gt;Phiếu bảo hành&lt;br&gt;Kỹ thuật viên&lt;br&gt;Phân công&lt;br&gt;Lịch hẹn" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="395" width="235" height="160" as="geometry"/></mxCell><mxCell id="e1" value="Thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="user" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTP / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="frontend" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Gọi nghiệp vụ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="controller" target="service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Đọc / ghi dữ liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="service" target="repository"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="SQL / JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="repository" target="database"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow" value="LUỒNG XỬ LÝ CHÍNH&lt;br&gt;&lt;br&gt;1. UI gửi request tới REST Controller.&lt;br&gt;2. Controller kiểm tra request cơ bản và chuyển Service.&lt;br&gt;3. Service thực thi quy tắc L4: chọn KTV phù hợp, kiểm tra khả dụng/trùng lịch.&lt;br&gt;4. Repository truy cập PostgreSQL.&lt;br&gt;5. Kết quả trả ngược về Controller → HTTP status + JSON → UI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="355" width="440" height="210" as="geometry"/></mxCell><mxCell id="nfrtitle" value="LẬP LUẬN KIẾN TRÚC TỪ NFR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1240" height="40" as="geometry"/></mxCell><mxCell id="nfr1" value="NFR1 – Hiệu năng&lt;br&gt;&lt;br&gt;Yêu cầu: 95% yêu cầu xem danh sách phản hồi ≤ 2 giây với 100 bản ghi mô phỏng.&lt;br&gt;&lt;br&gt;Quyết định: dùng REST API phân lớp, truy vấn qua Repository/JPA và chỉ lấy dữ liệu cần thiết; có thể bổ sung index ở các trường tra cứu/lịch.&lt;br&gt;&lt;br&gt;Đánh đổi: phải thiết kế truy vấn và index cẩn thận, tăng công sức kiểm thử hiệu năng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="395" height="235" as="geometry"/></mxCell><mxCell id="nfr2" value="NFR2 – Tính toàn vẹn lịch hẹn&lt;br&gt;&lt;br&gt;Yêu cầu: 100% yêu cầu tạo/xác nhận lịch phải kiểm tra dữ liệu bắt buộc và xung đột thời gian trước khi lưu.&lt;br&gt;&lt;br&gt;Quyết định: đặt kiểm tra nghiệp vụ tại AppointmentService/AssignmentService trước Repository; thao tác xác nhận và lưu thực hiện trong transaction.&lt;br&gt;&lt;br&gt;Đánh đổi: Service có thêm logic kiểm tra và transaction làm tăng độ phức tạp." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="670" width="395" height="235" as="geometry"/></mxCell><mxCell id="nfr3" value="NFR3 – Tính nhất quán API&lt;br&gt;&lt;br&gt;Yêu cầu: 100% API L4 trả HTTP status theo kết quả xử lý; dữ liệu không hợp lệ phải có mã lỗi và thông báo nguyên nhân.&lt;br&gt;&lt;br&gt;Quyết định: Controller dùng DTO/validation và cơ chế xử lý exception tập trung để chuẩn hóa error response.&lt;br&gt;&lt;br&gt;Đánh đổi: cần duy trì bộ mã lỗi và cấu trúc phản hồi thống nhất giữa các API." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="670" width="400" height="235" as="geometry"/></mxCell><mxCell id="legend" value="PHẠM VI&lt;br&gt;&lt;br&gt;Architecture này chỉ phục vụ luồng L4 đã chốt trong SRS/API Contract: phân công kỹ thuật viên và lịch hẹn. Không đưa kho, thanh toán, bán hàng, AI hay nghiệp vụ sửa chữa vào kiến trúc." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="1240" height="95" as="geometry"/></mxCell></root>
</mxGraphModel>
</diagram></mxfile>