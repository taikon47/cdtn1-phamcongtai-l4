        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;&lt;br&gt;👤 Actor&lt;br&gt;&lt;br&gt;🔵 Use case chính&lt;br&gt;&lt;br&gt;🟡 Use case được bao gồm (include)&lt;br&gt;&lt;br&gt;- - - → Quan hệ «include»" vertex="1">
