<mxfile host="app.diagrams.net" modified="2026-10-10T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="L4-UseCase" name="Use Case L4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HỆ THỐNG PHÂN CÔNG KỸ THUẬT VIÊN &amp;amp; LỊCH HẸN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="720" height="40" as="geometry"/></mxCell><mxCell id="boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="720" height="500" as="geometry"/></mxCell><mxCell id="actor" value="Nhân viên&lt;br&gt;điều phối" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="180" width="80" height="120" as="geometry"/></mxCell><mxCell id="uc1" value="&lt;b&gt;UC1&lt;/b&gt;&lt;br&gt;Xem phiếu bảo hành&lt;br&gt;cần phân công" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc2" value="&lt;b&gt;UC2&lt;/b&gt;&lt;br&gt;Xem thông tin&lt;br&gt;kỹ thuật viên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="155" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc3" value="&lt;b&gt;UC3&lt;/b&gt;&lt;br&gt;Kiểm tra lịch&lt;br&gt;kỹ thuật viên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="230" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc4" value="&lt;b&gt;UC4&lt;/b&gt;&lt;br&gt;Phân công&lt;br&gt;kỹ thuật viên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="305" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc5" value="&lt;b&gt;UC5&lt;/b&gt;&lt;br&gt;Tạo lịch hẹn&lt;br&gt;giao/nhận máy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="380" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc8" value="&lt;b&gt;UC8&lt;/b&gt;&lt;br&gt;Xem danh sách&lt;br&gt;lịch hẹn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="455" width="210" height="62" as="geometry"/></mxCell><mxCell id="uc6" value="&lt;b&gt;UC6&lt;/b&gt;&lt;br&gt;Kiểm tra&lt;br&gt;trùng lịch" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="175" height="70" as="geometry"/></mxCell><mxCell id="uc7" value="&lt;b&gt;UC7&lt;/b&gt;&lt;br&gt;Xác nhận&lt;br&gt;lịch hẹn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="385" width="175" height="70" as="geometry"/></mxCell><mxCell id="a1" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" style="endArrow=none;html=1;rounded=0;strokeWidth=1.2;" edge="1" parent="1" source="actor" target="uc8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc1" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc4" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc2" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc5" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc3" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc5" target="uc7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;&lt;br&gt;👤 Actor&lt;br&gt;&lt;br&gt;🔵 Use case chính&lt;br&gt;&lt;br&gt;🟢 Use case đang đặc tả (UC4)&lt;br&gt;&lt;br&gt;🟡 Use case được bao gồm (include)&lt;br&gt;&lt;br&gt;--→ Quan hệ &amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="45" width="260" height="245" as="geometry"/></mxCell><mxCell id="spec_title" value="ĐẶC TẢ USE CASE UC4 – PHÂN CÔNG KỸ THUẬT VIÊN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1220" height="42" as="geometry"/></mxCell><mxCell id="general" value="&lt;b&gt;1. Thông tin chung&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mã Use Case:&lt;/b&gt; UC4&lt;br&gt;&lt;b&gt;Tên Use Case:&lt;/b&gt; Phân công kỹ thuật viên&lt;br&gt;&lt;b&gt;Actor chính:&lt;/b&gt; Nhân viên điều phối&lt;br&gt;&lt;b&gt;Mục tiêu:&lt;/b&gt; Phân công kỹ thuật viên phù hợp cho phiếu bảo hành&lt;br&gt;&lt;b&gt;Phạm vi:&lt;/b&gt; Hệ thống Phân công kỹ thuật viên &amp;amp; Lịch hẹn&lt;br&gt;&lt;b&gt;Mức ưu tiên:&lt;/b&gt; MUST&lt;br&gt;&lt;b&gt;Liên quan:&lt;/b&gt; UC2, UC3, UC6, UC7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="330" height="250" as="geometry"/></mxCell><mxCell id="pre" value="&lt;b&gt;2. Tiền điều kiện&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Phiếu bảo hành tồn tại và đang chờ phân công.&lt;br&gt;&lt;br&gt;• Dữ liệu kỹ thuật viên đã có trong hệ thống (tay nghề, địa bàn, khối lượng công việc hiện tại, lịch làm việc)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="915" width="330" height="180" as="geometry"/></mxCell><mxCell id="main" value="&lt;b&gt;3. Luồng chính (Main Flow)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Nhân viên điều phối chọn phiếu bảo hành cần xử lý.&lt;br&gt;→ Hệ thống hiển thị thông tin phiếu bảo hành.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Nhân viên điều phối xem danh sách kỹ thuật viên.&lt;br&gt;→ Hệ thống hiển thị tay nghề, địa bàn và khối lượng công việc hiện tại.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Nhân viên điều phối chọn kỹ thuật viên phù hợp.&lt;br&gt;→ Hệ thống kiểm tra lịch làm việc, khả dụng và trùng lịch của kỹ thuật viên.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Nhân viên điều phối xác nhận phân công.&lt;br&gt;→ Hệ thống kiểm tra điều kiện phân công.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Hệ thống lưu kỹ thuật viên phụ trách cho phiếu bảo hành.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Hệ thống thông báo phân công thành công." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="650" width="430" height="445" as="geometry"/></mxCell><mxCell id="alt" value="&lt;b&gt;4. Luồng ngoại lệ (Alternative Flow)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2a. Không có kỹ thuật viên phù hợp:&lt;/b&gt;&lt;br&gt;• Hệ thống thông báo không tìm thấy kỹ thuật viên phù hợp.&lt;br&gt;• Nhân viên điều phối điều chỉnh tiêu chí hoặc thực hiện lại bước 2.&lt;br&gt;&lt;br&gt;&lt;b&gt;3a. Kỹ thuật viên bị trùng lịch:&lt;/b&gt;&lt;br&gt;• Hệ thống thông báo khoảng thời gian bị trùng.&lt;br&gt;• Nhân viên điều phối quay lại bước 3 để chọn kỹ thuật viên hoặc thời gian khác.&lt;br&gt;&lt;br&gt;&lt;b&gt;3b. Kỹ thuật viên không khả dụng hoặc quá tải:&lt;/b&gt;&lt;br&gt;• Hệ thống thông báo kỹ thuật viên không khả dụng hoặc đã đầy công việc.&lt;br&gt;• Nhân viên điều phối quay lại bước 3 để chọn kỹ thuật viên khác." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="420" height="335" as="geometry"/></mxCell><mxCell id="post" value="&lt;b&gt;5. Hậu điều kiện&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Phiếu bảo hành được gán cho một kỹ thuật viên phù hợp.&lt;br&gt;• Thông tin phân công được lưu trong hệ thống." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="1000" width="420" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
