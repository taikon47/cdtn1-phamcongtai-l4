        </mxCell>
        <mxCell id="spec_title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;" value="ĐẶC TẢ USE CASE UC4 – PHÂN CÔNG KỸ THUẬT VIÊN" vertex="1">
          <mxGeometry height="42" width="1280" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="info" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;1. Thông tin chung&lt;/b&gt;&lt;br&gt;&lt;br&gt; &lt;b&gt;Mã Use Case:&lt;/b&gt; UC4&lt;br&gt; &lt;b&gt;Tên Use Case:&lt;/b&gt; Phân công kỹ thuật viên&lt;br&gt; &lt;b&gt;Actor chính:&lt;/b&gt; Nhân viên điều phối&lt;br&gt; &lt;b&gt;Mục tiêu:&lt;/b&gt; Phân công kỹ thuật viên phù hợp cho phiếu bảo hành&lt;br&gt; &lt;b&gt;Phạm vi:&lt;/b&gt; Hệ thống Phân công kỹ thuật viên &amp;amp; Lịch hẹn&lt;br&gt; &lt;b&gt;Mức ưu tiên:&lt;/b&gt; MUST&lt;br&gt; &lt;b&gt;Liên quan:&lt;/b&gt; UC2, UC3, UC6, UC7" vertex="1">
          <mxGeometry height="260" width="360" x="40" y="670" as="geometry" />
        </mxCell>
        <mxCell id="pre" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;2. Tiền điều kiện&lt;/b&gt;&lt;br&gt;&lt;br&gt; • Phiếu bảo hành tồn tại và đang chờ phân công.&lt;br&gt;&lt;br&gt; • Dữ liệu kỹ thuật viên đã có trong hệ thống." vertex="1">
          <mxGeometry height="150" width="360" x="40" y="945" as="geometry" />
        </mxCell>
        <mxCell id="main" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;3. Luồng chính (Main Flow)&lt;/b&gt;&lt;br&gt;&lt;br&gt; &lt;b&gt;1.&lt;/b&gt; NV điều phối chọn phiếu bảo hành cần xử lý.&lt;br&gt; → Hệ thống hiển thị thông tin phiếu bảo hành.&lt;br&gt;&lt;br&gt; &lt;b&gt;2.&lt;/b&gt; Xem danh sách kỹ thuật viên.&lt;br&gt; → Hiển thị tay nghề, địa bàn và khối lượng công việc hiện tại.&lt;br&gt;&lt;br&gt; &lt;b&gt;3.&lt;/b&gt; Chọn kỹ thuật viên phù hợp.&lt;br&gt; → Hiển thị lịch làm việc của kỹ thuật viên.&lt;br&gt;&lt;br&gt; &lt;b&gt;4.&lt;/b&gt; Xác nhận phân công.&lt;br&gt; → Kiểm tra điều kiện: kỹ thuật viên phù hợp, khả dụng.&lt;br&gt;&lt;br&gt; &lt;b&gt;5.&lt;/b&gt; Hệ thống lưu kỹ thuật viên phụ trách cho phiếu bảo hành.&lt;br&gt;&lt;br&gt; &lt;b&gt;6.&lt;/b&gt; Hệ thống thông báo phân công thành công." vertex="1">
          <mxGeometry height="425" width="430" x="420" y="670" as="geometry" />
        </mxCell>
        <mxCell id="alt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;4. Luồng ngoại lệ (Alternative Flow)&lt;/b&gt;&lt;br&gt;&lt;br&gt; &lt;b&gt;4a. Không có kỹ thuật viên phù hợp:&lt;/b&gt;&lt;br&gt; • Hệ thống thông báo không tìm thấy kỹ thuật viên phù hợp.&lt;br&gt; • Nhân viên điều phối quay lại bước 2 để tìm lại.&lt;br&gt;&lt;br&gt; &lt;b&gt;6a. Kỹ thuật viên bị trùng lịch:&lt;/b&gt;&lt;br&gt; • Hệ thống cảnh báo trùng lịch.&lt;br&gt; • Không cho xác nhận phân công.&lt;br&gt; • Nhân viên điều phối chọn kỹ thuật viên hoặc thời gian khác.&lt;br&gt;&lt;br&gt; &lt;b&gt;6b. Kỹ thuật viên không khả dụng (đã đầy công việc):&lt;/b&gt;&lt;br&gt; • Hệ thống thông báo kỹ thuật viên không khả dụng.&lt;br&gt; • Nhân viên điều phối chọn kỹ thuật viên khác." vertex="1">
          <mxGeometry height="320" width="450" x="870" y="670" as="geometry" />
        </mxCell>
        <mxCell id="post" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;5. Hậu điều kiện&lt;/b&gt;&lt;br&gt;&lt;br&gt; • Phiếu bảo hành được gán cho một kỹ thuật viên phù hợp.&lt;br&gt; • Thông tin phân công được lưu trong hệ thống." vertex="1">
          <mxGeometry height="90" width="450" x="870" y="1005" as="geometry" />
        </mxCell>
      </root>
