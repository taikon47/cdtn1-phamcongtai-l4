<diagram id="erd-l4" name="ERD L4">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ERD – L4: PHÂN CÔNG KỸ THUẬT VIÊN &amp; LỊCH HẸN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1240" height="45" as="geometry"/></mxCell><mxCell id="sub" value="Mô hình dữ liệu phục vụ UC1–UC8 • PostgreSQL • PK/FK rõ ràng • Không mở rộng ngoài phạm vi L4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1240" height="32" as="geometry"/></mxCell><mxCell id="ticket" value="&lt;b&gt;WARRANTY_TICKET&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; ticket_id : BIGINT&lt;br&gt;ticket_code : VARCHAR(30) UNIQUE&lt;br&gt;customer_name : VARCHAR(120)&lt;br&gt;device_name : VARCHAR(120)&lt;br&gt;issue_description : TEXT&lt;br&gt;required_skill : VARCHAR(100)&lt;br&gt;service_area : VARCHAR(100)&lt;br&gt;status : VARCHAR(30)&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="280" height="270" as="geometry"/></mxCell><mxCell id="tech" value="&lt;b&gt;TECHNICIAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; technician_id : BIGINT&lt;br&gt;full_name : VARCHAR(120)&lt;br&gt;skill : VARCHAR(100)&lt;br&gt;service_area : VARCHAR(100)&lt;br&gt;current_workload : INTEGER&lt;br&gt;availability_status : VARCHAR(30)&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="280" height="250" as="geometry"/></mxCell><mxCell id="assign" value="&lt;b&gt;ASSIGNMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; assignment_id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; ticket_id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; technician_id : BIGINT&lt;br&gt;assigned_at : TIMESTAMP&lt;br&gt;status : VARCHAR(30)&lt;br&gt;&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; ticket_id&lt;br&gt;&lt;i&gt;Một phiếu chỉ có một KTV phụ trách&lt;br&gt;trong phạm vi phân công hiện tại.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="280" height="255" as="geometry"/></mxCell><mxCell id="appt" value="&lt;b&gt;APPOINTMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; appointment_id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; ticket_id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; technician_id : BIGINT&lt;br&gt;appointment_type : VARCHAR(20)&lt;br&gt;start_time : TIMESTAMP&lt;br&gt;end_time : TIMESTAMP&lt;br&gt;status : VARCHAR(30)&lt;br&gt;created_at : TIMESTAMP&lt;br&gt;&lt;br&gt;&lt;i&gt;Không cho phép chồng lấn thời gian&lt;br&gt;của cùng một kỹ thuật viên.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="300" height="300" as="geometry"/></mxCell><mxCell id="rules" value="QUY TẮC DỮ LIỆU BÁM SRS&lt;br&gt;&lt;br&gt;BR1 → ASSIGNMENT.ticket_id UNIQUE: một phiếu chỉ có một KTV phụ trách hiện tại.&lt;br&gt;&lt;br&gt;BR2–BR3 → TECHNICIAN lưu tay nghề, địa bàn, khối lượng công việc để hỗ trợ lựa chọn.&lt;br&gt;&lt;br&gt;BR4 → trước khi xác nhận APPOINTMENT phải kiểm tra khoảng thời gian của cùng technician_id không chồng lấn.&lt;br&gt;&lt;br&gt;BR5 → APPOINTMENT bắt buộc gắn với WARRANTY_TICKET và TECHNICIAN.&lt;br&gt;&lt;br&gt;BR6 → chỉ lưu/xác nhận khi dữ liệu lịch hẹn hợp lệ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="350" height="300" as="geometry"/></mxCell><mxCell id="scope" value="PHẠM VI ERD&lt;br&gt;&lt;br&gt;4 bảng lõi đủ để triển khai prototype L4: phiếu bảo hành, kỹ thuật viên, phân công và lịch hẹn. Customer không tách thành bảng riêng vì SRS L4 chỉ cần thông tin khách hàng phục vụ phiếu/lịch; không triển khai module quản lý khách hàng độc lập." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="845" width="1160" height="95" as="geometry"/></mxCell><mxCell id="r1" value="1  —  0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ticket" target="assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1  —  0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech" target="assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="1  —  0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ticket" target="appt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="1  —  0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech" target="appt"><mxGeometry relative="1" as="geometry"/></mxCell></root>
</mxGraphModel>
</diagram></mxfile>