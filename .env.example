# =========================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO DỰ ÁN SMART CRM MEKONG MOBILE - LUỒNG L4 (BT3)
# Sao chép file này thành .env để chạy: cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env chứa thông tin mật lên GitHub repo
# =========================================================================

# Cổng mở ra máy host của ứng dụng
APP_PORT=8081

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
DB_NAME=projectl4
DB_USER=postgres
DB_PASSWORD=postgres

# Cấu hình Secret ký token (dài ít nhất 32 ký tự theo chuẩn bảo mật A02)
JWT_SECRET=c21hcnQtY3JtLW1la29uZy1tb2JpbGUtYXV0aC1zZWNyZXQta2V5LTIwMjY=

# Danh sách nguồn Frontend cho phép qua CORS (ngăn chặn rủi ro CSRF)
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Mức ghi log hệ thống (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO
